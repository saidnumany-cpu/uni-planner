+/* ==========================================================================
+   29. Utility Classes
+   Bileşenlerde kullanılan ancak daha önce tanımlanmamış yardımcı sınıflar.
+   (Tailwind kurulu olmadığı için bu sınıflar boş kalıyor ve HomeworkList,
+   HomeworkModal, WeeklyNotes, CourseDetail, WeeklySchedule gibi yerlerde
+   boşluk/renk/hizalama sessizce kayboluyordu.)
+   ========================================================================== */
+
+/* Flex yardımcıları */
+.flex-1 { flex: 1 1 0%; }
+.flex-shrink-0 { flex-shrink: 0; }
+.items-center { align-items: center; }
+.items-start { align-items: flex-start; }
+.justify-end { justify-content: flex-end; }
+.gap-xs { gap: var(--space-xs); }
+.overflow-x-auto {
+  overflow-x: auto;
+  -webkit-overflow-scrolling: touch;
+}
+
+/* Boşluklar (padding / margin) */
+.p-4 { padding: var(--space-md); }
+.pt-1 { padding-top: 4px; }
+.pb-2 { padding-bottom: var(--space-sm); }
+.pb-20 { padding-bottom: 80px; }
+.mb-1 { margin-bottom: 4px; }
+.mb-2 { margin-bottom: var(--space-sm); }
+.mb-3 { margin-bottom: 12px; }
+.mb-4 { margin-bottom: var(--space-md); }
+.mb-6 { margin-bottom: var(--space-lg); }
+.ml-2 { margin-left: var(--space-sm); }
+.mt-2 { margin-top: var(--space-sm); }
+.mt-4 { margin-top: var(--space-md); }
+
+/* Tipografi */
+.text-4xl { font-size: 2.25rem; line-height: 1; }
+.text-center { text-align: center; }
+.uppercase { text-transform: uppercase; }
+.tracking-wider { letter-spacing: 0.05em; }
+.font-semibold { font-weight: 600; }
+.text-white { color: #fff; }
+
+/* Renkler */
+.text-red-400 { color: #f87171; }
+.hover\:text-red-300:hover { color: #fca5a5; }
+.text-emerald-400 { color: #34d399; }
+.accent-emerald-500 { accent-color: var(--accent-emerald); }
+
+/* Kenarlık / gölge / köşe yuvarlama */
+.rounded { border-radius: var(--glass-radius-sm); }
+.rounded-lg { border-radius: var(--glass-radius); }
+.border-white\/30 { border-color: rgba(255, 255, 255, 0.3); }
+.border-white\/40 { border-color: rgba(255, 255, 255, 0.4); }
+.bg-white\/10 { background-color: rgba(255, 255, 255, 0.1); }
+.shadow-inner { box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.25); }
+.shadow-lg { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
+
+/* Boyutlandırma */
+.w-5 { width: 20px; }
+.h-5 { height: 20px; }
+.min-h-\[300px\] { min-height: 300px; }
+
+/* Diğer */
+.cursor-pointer { cursor: pointer; }
+.line-clamp-2 {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
